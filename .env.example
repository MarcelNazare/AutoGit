# ── Remote URL ──────────────────────────────────────────────────────
# Base or full URL. If it doesn't end in .git, autogit appends
# /<project-directory-name>.git automatically.
#
#   GIT_REMOTE_URL=git@github.com:yourname
#   GIT_REMOTE_URL=git@github.com:yourname/my-project.git
#
GIT_REMOTE_URL=git@github.com:yourname

# ── GitHub repo auto-creation ───────────────────────────────────────
# If the remote points at a GitHub URL that doesn't exist yet, autogit
# offers to create it. Two ways to enable that:
#
#   1. Install the `gh` CLI (https://cli.github.com) and run `gh auth login`
#   2. Uncomment GITHUB_TOKEN below (classic PAT with `repo` scope)
#
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Visibility for auto-created repos: private (default) or public.
# GITHUB_VISIBILITY=private

